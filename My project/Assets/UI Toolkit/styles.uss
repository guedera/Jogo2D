.title {
    font-size: 61px;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/OpenSans-Light.ttf?fileID=12800000&guid=b0c954878610c244abbc5367c4b66e09&type=3#OpenSans-Light");
    -unity-font-style: normal;
    -unity-text-align: upper-center;
    -unity-text-auto-size: none;
}

.defaultInput {
    justify-content: center;
    align-self: center;
    align-content: center;
    border-left-color: rgb(179, 179, 179);
    border-right-color: rgb(179, 179, 179);
    border-top-color: rgb(179, 179, 179);
    border-bottom-color: rgb(179, 179, 179);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    flex-direction: row;
    flex-wrap: nowrap;
    flex-basis: auto;
    align-items: center;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    flex-shrink: initial;
    margin-bottom: 10px;
    flex-grow: initial;
    height: auto;
    width: auto;
    min-height: auto;
    max-height: none;
    min-width: auto;
    padding-bottom: 0;
    padding-top: 0;
    padding-right: 10px;
    padding-left: 10px;
}

.defaultInput > #unity-text-input {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(55, 55, 55, 0);
    border-right-color: rgba(55, 55, 55, 0);
    border-top-color: rgba(55, 55, 55, 0);
    border-bottom-color: rgba(55, 55, 55, 0);
    font-size: 15px;
    align-content: flex-start;
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: initial;
    min-width: initial;
    width: initial;
}

.defaultInput > Label {
    -unity-text-align: middle-left;
    font-size: 15px;
    -unity-font-style: normal;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/OpenSans-Bold.ttf?fileID=12800000&guid=a156cc44e3caec6409485be1cc6157d8&type=3#OpenSans-Bold");
    flex-basis: initial;
    align-content: flex-start;
    flex-shrink: 1;
    flex-grow: 0;
    min-width: auto;
}

.defaultButton {
    flex-grow: 1;
    max-height: initial;
    min-height: initial;
    height: 55px;
    flex-basis: auto;
    flex-shrink: 1;
}

.paragraph {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/OpenSans-Bold.ttf?fileID=12800000&guid=a156cc44e3caec6409485be1cc6157d8&type=3#OpenSans-Bold");
    -unity-text-align: upper-center;
    font-size: 17px;
}
